# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-host>/neondb?ssl=require

# Clerk Authentication (Found in Clerk Dashboard -> API Keys & JWT Templates)
CLERK_ISSUER=https://<your-clerk-subdomain>.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Allowed Frontend Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Groq AI API Key (from https://console.groq.com)
GROQ_API_KEY=gsk_...

# Redis Cache URL (Local redis://localhost:6379/0 or Upstash rediss://...)
REDIS_URL=redis://localhost:6379/0
